# ─── VoxVision School OS — environment configuration ────────────────────────
# Copy to .env.local for local development. NEVER commit real values.
# Every variable here is read on the SERVER only. Nothing is exposed to the browser.

# presentation | production
#   presentation: shows the synthetic-data banner, one-click role sign-in and the
#                 "reset presentation data" action. Use ONLY with synthetic data.
#   production:   disables all of the above. Required before any real school data.
APP_ENV=presentation

# PostgreSQL connection (Supabase / Neon / RDS). Required for any hosted deployment.
# If unset, an embedded PGlite database is used (local development and tests only).
DATABASE_URL=
# Embedded database location when DATABASE_URL is unset ("memory" = non-persistent).
PGLITE_DIR=.data/pglite

# Password applied to seeded presentation accounts (presentation mode only).
SEED_PASSWORD=

# Comma-separated list of browser origins allowed to make state-changing requests,
# e.g. the public domain that proxies this zone.
ALLOWED_ORIGINS=https://www.voxvision.site

# AI provider (server-side only). Leave both keys empty to run without AI: features fall
# back to retrieval from approved material and say so on screen.
# AI_PROVIDER = anthropic | gemini. If unset, whichever key is set is used (Anthropic first).
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Google Gemini (free tier available at aistudio.google.com). Free-tier terms may allow
# Google to use requests to improve its products: use with synthetic data only; a paid
# plan is required before any real student or parent information is processed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tried in order when the main model is busy or over its free-tier limit.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest
# Hard cap on AI requests per user per hour (cost control; API usage is billed separately).
AI_HOURLY_LIMIT_PER_USER=30
